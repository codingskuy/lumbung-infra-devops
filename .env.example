# Contoh variabel untuk uji lokal. HANYA nama; isi sendiri di .env (diabaikan git) atau GitHub Actions secrets.
# Jangan pernah commit nilai. Lihat docs/secrets.md.

# DB logis `lumbung` saja (pengguna lumbung_app, tanpa SUPERUSER)
DATABASE_URL=
# Kunci penandatangan JWT Ed25519 (backend)
JWT_ED25519_PRIVATE=
# Kunci publik verifikasi JWT (bukan rahasia; hanya bila backend/verifier memintanya)
JWT_ED25519_PUBLIC=
# Kunci perangkat gudang (satu per gudang; rotasi 90 hari + tenggang 7 hari)
DEVICE_API_KEY_GUDANG=
# Kunci layanan least-privilege (pipeline, ai-models)
SERVICE_API_KEY=
# Kunci API web sisi server (rotasi 90 hari)
LUMBUNG_API_KEY=
